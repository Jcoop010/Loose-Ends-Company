# Loose Ends Operations OS - Environment Configuration Example
# Copy this file to .env.local for local development.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# --- Scouting Agent (scripts/scoutProspects.ts) ---
# Service-role key — NEVER expose client-side. Keep out of VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: workspace UUID to associate scouted leads
DEFAULT_WORKSPACE_ID=

# Optional: override default "United States" market for live discovery
TARGET_MARKET=

# Optional: Live SMB directory discovery keys (Google Places API v1 or Serper.dev fallback)
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
