VITE_SUPABASE_URL=https://uehfvpnnoitgybsmdgef.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Lxk1H5zRhlKkx8IVHV7Aiw_EXC4BC2g

# --- Scouting & Outreach Agents (scripts/scoutProspects.ts, scripts/generateOutreachDrafts.ts) ---
# Service-role key from Supabase Dashboard -> Project Settings -> API
# NEVER expose client-side and NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Workspace UUID from public.workspaces (leave blank if your project has a single workspace)
DEFAULT_WORKSPACE_ID=

# Optional: override default rotated US metro market for live discovery
TARGET_MARKET=

# Optional: Live SMB directory discovery keys (Google Places API v1 or Serper.dev fallback)
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=
