# Loose Ends Operations OS - Environment Configuration Example
# Copy this file to .env.local for local development.
# Authoritative Repository: Jcoop010/Loose-Ends-Company
# Authoritative Production App: https://loose-ends-os.vercel.app/

VITE_SUPABASE_URL=https://uehfvpnnoitgybsmdgef.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Lxk1H5zRhlKkx8IVHV7Aiw_EXC4BC2g

# --- Scouting & Outreach Agents (scripts/scoutProspects.ts, scripts/generateOutreachDrafts.ts) ---
# Service-role key from Supabase Dashboard -> Project Settings -> API
# NEVER expose client-side and NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Workspace UUID from public.workspaces (leave blank if your project has a single workspace)
DEFAULT_WORKSPACE_ID=

# Optional: override default rotated US metro market for live discovery
TARGET_MARKET=

# Optional: Live SMB directory discovery keys (Google Places API v1 or Serper.dev fallback)
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=

# --- Live Approved Outreach Sender (scripts/sendApprovedDrafts.ts) ---
# Dispatches ONLY drafts where status = 'approved' and delivery_status = 'not_sent'
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=Loose Ends Operations <operations@looseends.co>

# Optional: SMTP Relay fallback if RESEND_API_KEY is not used
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# --- Grok Accounting & Outreach Bots (xAI Responses API: https://api.x.ai/v1/responses) ---
XAI_API_KEY=
XAI_MODEL=grok-4.7
